{
  "name": "GEO",
  "version": "1.1.2",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "webRequest"
  ],
  
  "host_permissions": [
    "http://*/*",   
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "paw.png",
    "48": "paw.png",
    "128": "paw.png"
  }
}
