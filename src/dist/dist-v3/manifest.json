{
  "name": "GEO",
  "version": "1.1.3",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "webRequest"
  ],
  
  "host_permissions": [
    "http://*/*",   
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.geoguessr.com/*"],
      "js": ["content.js"]
    }
  ],
  
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "paw.png",
    "48": "paw.png",
    "128": "paw.png"
  }
}
