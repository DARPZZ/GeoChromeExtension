{
  "name": "GEO",
  "version": "1.1.8",
  "manifest_version": 2,
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "permissions": [
    "storage",
    "activeTab",
    "webRequest",
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.geoguessr.com/*"],
      "js": ["content.js"]
    }
  ],
  "browser_action":
  {
    "default_icon": "paw.png",
    "default_popup": "popup.html",
    "default_title": "GEO Extension"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
      "default": "Ctrl+Shift+Y"
      }
    }
  },

  "icons": {
    "16": "paw.png",
    "48": "paw.png",
    "128": "paw.png"
  }
}
